# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production / shared dev: MySQL
# DATABASE_URL=mysql+pymysql://notif_user:notif_password@localhost:3306/notification_db
#
# Local MVP with no MySQL server running (SQLite file, zero setup):
DATABASE_URL=sqlite:///./notification.db

# ---------------------------------------------------------------------------
# Microsoft Teams (Power Automate "When a Teams webhook request is received")
# ---------------------------------------------------------------------------
TEAMS_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Slack (Bot Token from a Slack App with chat:write, im:write, users:read,
# users:read.email scopes)
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Email (SMTP - e.g. Gmail with an App Password)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=

# ---------------------------------------------------------------------------
# Provider fallback
# ---------------------------------------------------------------------------
# If true, always use the in-memory Mock provider for every channel
# regardless of whether real credentials are configured above. Useful for
# local demos and CI. If false (default), each channel falls back to Mock
# automatically only when its own credentials are missing.
FORCE_MOCK_PROVIDERS=false

# ---------------------------------------------------------------------------
# Retry policy
# ---------------------------------------------------------------------------
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=2

# ---------------------------------------------------------------------------
# Webhook security
# ---------------------------------------------------------------------------
# Shared secret providers must send back as `X-Webhook-Secret` header when
# calling POST /api/webhooks/{provider}. Generate any random string.
WEBHOOK_SHARED_SECRET=change-me

# ---------------------------------------------------------------------------
# CORS - comma separated origins allowed to call this API from a browser.
# Use * for the local demo (Frontend/ opened as static files / file://).
# ---------------------------------------------------------------------------
CORS_ORIGINS=*
